.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(68, 138, 255);
}

.unity-tree-view__item-content {
    flex-shrink: 1;
}

.unity-toggle__text {
    flex-shrink: 1;
    padding-left: 0;
    text-overflow: ellipsis;
    overflow: hidden;
    flex-grow: 0;
    margin-left: 3px;
}

.unity-toggle__checkmark {
    flex-shrink: 0;
    flex-grow: 0;
}

.unity-toggle__input {
    align-items: stretch;
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
}

Toggle.hidden #unity-checkmark {
    visibility: hidden;
}
